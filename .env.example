IOS_BUNDLE_ID=com.example.myapp
ANDROID_PACKAGE=com.example.myapp
IOS_DEVICE_NAME=iPhone 16
ANDROID_DEVICE_NAME=Pixel
IOS_APP_PATH=apps/app.ipa
ANDROID_APP_PATH=apps/app.apk
# dev | uat | prod  (test data is picked from testdata/<env>, then testdata/common)
TEST_ENV=uat
TEST_PASSWORD=changeme

# Sauce Labs. RUN_ON_SAUCE=true runs on Sauce, anything else runs locally.
# Credentials: never commit real values.
RUN_ON_SAUCE=false
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=eu-central-1
SAUCE_SESSION_DURATION=PT1H
SAUCE_IOS_DEVICE_NAME=iPhone
SAUCE_ANDROID_DEVICE_NAME=Google_Pixel(?!.*Fold)
SAUCE_IOS_APP=storage:filename=app.ipa
SAUCE_ANDROID_APP=storage:filename=app.apk
