{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@core/*": ["./src/core/*"], "@pages/*": ["./src/pages/*"], "@fixtures/*": ["./src/fixtures/*"] }
  },
  "include": ["src", "tests", "mobilewright.config.ts"]
}
